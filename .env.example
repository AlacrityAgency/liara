# نسخه‌ی نمونه‌ی متغیرهای محیطی سُکان. این فایل را به `.env` کپی کنید و مقادیر را پر کنید؛ `.env` در git نمی‌آید.
# توکن API لیارا؛ خالی بماند تا سُکان در حالت شبیه‌سازی محلی اجرا شود.
LIARA_API_TOKEN=
# شناسه‌ی تیم لیارا (اختیاری)؛ اگر حساب شما عضو تیم است، مقدار آن را وارد کنید.
LIARA_TEAM_ID=
# نام اپلیکیشن لیارا که سُکان روی آن کار می‌کند؛ برای SRE زنده لازم است.
SOKAN_APP=
# مسیر پوشه‌ی پروژه‌ای که تحلیل و بسته‌بندی می‌شود.
SOKAN_PROJECT_DIR=
# کلید امضای توکن‌های تأیید و زنجیره‌ی ممیزی؛ بدون آن هر بار اجرا تصادفی است و تأییدها پس از ری‌استارت باطل می‌شوند.
SOKAN_SECRET=
# توکن ورود به کنسول وب و MCP؛ خالی بماند تا توکن تصادفی هنگام اجرا چاپ شود.
SOKAN_CONSOLE_TOKEN=
# آدرس میزبان کنسول سُکان؛ پیش‌فرض 127.0.0.1 است و بهتر است همان بماند.
SOKAN_HOST=
# پورت کنسول سُکان؛ پیش‌فرض 4000 است.
SOKAN_PORT=
# کلید API مدل زبانی برای گفت‌وگوی فارسی؛ بدون آن پاسخ‌ها از حالت آفلاین (قاعده‌محور) می‌آیند.
SOKAN_LLM_API_KEY=
# آدرس پایه‌ی API سازگار با OpenAI برای مدل زبانی.
SOKAN_LLM_BASE_URL=https://agentrouter.org/v1
# نام مدل زبانی که برای tool-calling استفاده می‌شود.
SOKAN_LLM_MODEL=
# پورت اپلیکیشن دمو chaos-shop در حالت شبیه‌سازی؛ پیش‌فرض 3100 است.
CHAOS_PORT=
